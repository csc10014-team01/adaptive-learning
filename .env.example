# API Server Configuration
PORT=8000
ENVIRONMENT=development

# Model & Provider Keys (Không commit key thật lên repo)
OPENAI_API_KEY=
LOCAL_MODEL_ENDPOINT=http://localhost:11434

# Storage / Database (nếu có dùng local SQLite / PostgreSQL)
DATABASE_URL=sqlite:///./test.db

# Fake MVP1 teacher API: set an actual secret in the process environment.
# No built-in token; unset configuration denies all teacher routes.
FAKE_API_TEACHER_TOKEN=
# Optional: a directory containing student_profiles.json and questions.json.
# FAKE_API_FIXTURE_DIR=
# Optional explicit browser origins, comma-separated (no wildcard by default).
# FAKE_API_CORS_ORIGINS=http://localhost:5173

# Integrated finalized Generator (explicit opt-in; existing fake API defaults remain).
# Values are process environment settings; this app does not automatically load .env.
# python -m src.ui selects qwen/m3 and experimental mode unless explicitly disabled.
# EXAM_BACKEND=qwen
# PROFILE_SOURCE=m3
# M3_QUESTION_DB=data/sample/dataset/question_bank.db
# M3_STUDENT_DB=data/sample/memory/student_profiles_sample.db
# EXAM_DB=data/runtime/exams.db
# API_TEACHER_TOKEN=
# OLLAMA_BASE_URL=http://127.0.0.1:11434
# QWEN_MODEL=qwen3:1.7b
# QWEN_TIMEOUT_SECONDS=45
# QWEN_MAX_ATTEMPTS=2
# EXAM_TIMEOUT_SECONDS=180
# KORO_EXPERIMENTAL_INDIRECT=0
# SKILL_RELATIONSHIPS_FILE=config/skill_relationships_a001_a009.json
