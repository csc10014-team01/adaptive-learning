# API Server Configuration
PORT=8000
ENVIRONMENT=development

# Personalized backend (default). Set process environment; no automatic .env loading.
EXAM_BACKEND=qwen
PROFILE_SOURCE=m3
API_TEACHER_TOKEN=
OLLAMA_BASE_URL=http://127.0.0.1:11434
QWEN_MODEL=qwen3:1.7b
QWEN_TIMEOUT_SECONDS=45
QWEN_MAX_ATTEMPTS=2
EXAM_TIMEOUT_SECONDS=180
# Optional relationship policy; IDs must exactly match the data skill catalogue.
# The confirmed pre-work database contains all A001-A009 IDs and template links.
# Enable the approved P3/P2/P1 policy for that nine-skill catalogue.
# SKILL_RELATIONSHIPS_FILE=config/skill_relationships_a001_a009.json
# Optional presentation registry; shipped Indirect proposals are inactive until author review.
# TEMPLATE_PRESENTATIONS_FILE=config/template_presentations.json
# Local MVP experimentation; src.ui enables this by default. Set 0 for strict verified-only behavior.
KORO_EXPERIMENTAL_INDIRECT=1
# Data Lead source; app-local data/sample/memory contains an offline seeded testing copy.
# M3_STUDENT_DB=../../pre-work/data/sample/memory/student_profiles_sample.db
# M3_QUESTION_DB=../../pre-work/data/sample/dataset/question_bank.db
# EXAM_DB=data/runtime/exams.db
# API_CORS_ORIGINS=http://localhost:5173
# When PROFILE_SOURCE=json: API_PROFILE_DIR=<directory containing student_profiles.json>

# Model & Provider Keys (Không commit key thật lên repo)
OPENAI_API_KEY=
LOCAL_MODEL_ENDPOINT=http://localhost:11434

# Storage / Database (nếu có dùng local SQLite / PostgreSQL)
DATABASE_URL=sqlite:///./test.db

# Fake MVP1 teacher API: set an actual secret in the process environment.
# No built-in token; unset configuration denies all teacher routes.
FAKE_API_TEACHER_TOKEN=
# Optional: a directory containing student_profiles.json and questions.json.
# FAKE_API_FIXTURE_DIR=
# Optional explicit browser origins, comma-separated (no wildcard by default).
# FAKE_API_CORS_ORIGINS=http://localhost:5173
